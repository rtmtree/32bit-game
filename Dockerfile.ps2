FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    texinfo \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    zlib1g-dev \
    libncurses5-dev

# Clone and build PS2SDK
RUN git clone https://github.com/ps2dev/ps2toolchain.git /tmp/ps2toolchain
WORKDIR /tmp/ps2toolchain
RUN ./toolchain.sh

# Set up environment
ENV PATH="/usr/local/ps2dev/ee/bin:$PATH"
ENV PS2SDK="/usr/local/ps2dev/ps2sdk"

WORKDIR /workspace
